{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clover Launcher",
  "version": "0.0.1",
  "identifier": "dev.blackdevlabs.clover",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Clover Launcher",
        "width": 960,
        "height": 620,
        "minWidth": 640,
        "minHeight": 440,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/instances/*/minecraft/screenshots/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFRjZFNkMyNjg1MTIxOUYKUldTZklWRm93dWIyUG4rZEJiMTkvam5NbHI3dzVWKytkVmNuQWdMMitQOXhqWDlLb0NJT1dtMGkK",
      "endpoints": [
        "https://github.com/CloverNetwork/Clover-Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
